                }
              },
              "label" : [ {
                "locale" : "en_US",
                "text" : "Permit type"
              } ]
            }
          }, {
            "type" : "Field",
            "id" : "/Permit/SubmittedOn",
            "name" : "SubmittedOn",
            "Field" : {
              "fieldType" : {
                "type" : "DateType",
                "DateType" : {
                  "format" : "yyyy-MM-dd"
                }
              },
              "label" : [ {
                "locale" : "en_US",
                "text" : "Submitted on"
