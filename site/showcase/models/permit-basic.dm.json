                "text" : "Requested area (m²)"
              } ]
            }
          }, {
            "type" : "Field",
            "id" : "/Permit/UnitFee",
            "name" : "UnitFee",
            "Field" : {
              "fieldType" : {
                "type" : "NumberType",
